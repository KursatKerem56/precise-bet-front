# Copy to .env and fill in. .env is git-ignored.

# Backend base URL.
VITE_API_URL=http://localhost:3005

# Sent verbatim as the Authorization header. No "Bearer" prefix.
# Use a development token only. Never commit a production token, and never ship
# one in a browser bundle — put a server-side proxy in front of the API instead.
VITE_AUTH_TOKEN=

# "true" renders bundled sample data instead of calling the API. Development aid only.
VITE_USE_SAMPLE_DATA=false
